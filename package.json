    "test:browser": "playwright test"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "lucide": "1.61.0",
    "tailwindcss": "4.3.3"
  }
}
