# Single sanitized runtime configuration template for the document workflow.
# Copy to config/azure.env. Never commit the populated file.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_STORAGE_ACCOUNT=REPLACE_WITH_STORAGE_ACCOUNT
AZURE_STORAGE_ACCOUNT_URL=https://REPLACE_WITH_STORAGE_ACCOUNT.blob.core.windows.net
AZURE_STORAGE_CONTAINER=aari-documents
AZURE_BLOB_CONTAINER=aari-documents
AZURE_BLOB_PREFIX=raw/99_restricted/avaron/2026-07-10

GMAIL_AUTH_MODE=oauth
GMAIL_USER=me
GMAIL_CREDENTIALS_PATH=./secrets/client_secret.json
GMAIL_TOKEN_PATH=./secrets/token.json
GOOGLE_APPLICATION_CREDENTIALS=
GMAIL_IMPERSONATE_USER=

AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=aari-documents

AVARON_RECEIPTS_DIR=./restricted_inputs/avaron/2026-07-10
AARI_RUN_OUTPUT=./run_output
